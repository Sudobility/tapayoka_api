{
  "name": "tapayoka_api",
  "version": "0.0.68",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:prod": "bun run dist/index.js",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "bunx eslint src",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx prettier --write src",
    "format:check": "bunx prettier --check src",
    "db:migrate": "bun run src/db/migrate.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@sudobility/test-db-guard": "^1.0.3",
    "@types/bun": "latest",
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "drizzle-kit": "~0.31.11",
    "eslint": "~9.39.5",
    "eslint-plugin-import": "~2.32.0",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "dependencies": {
    "@hono/zod-validator": "~0.7.6",
    "@sudobility/auth_service": "^1.1.28",
    "@sudobility/entity_service": "^1.0.48",
    "@sudobility/tapayoka_types": "^0.0.58",
    "@sudobility/types": "^1.9.75",
    "drizzle-orm": "~0.45.4",
    "ethers": "~6.17.0",
    "firebase-admin": "~13.10.0",
    "hono": "~4.13.13",
    "postgres": "~3.4.9",
    "stripe": "~17.7.0",
    "zod": "~3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/tapayoka_api.git"
  }
}
